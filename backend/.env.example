# ==============================================================================
# L&K Skill Hub — Production-Ready Environment Configuration
# ==============================================================================

# Server Configuration
PROJECT_NAME="L&K Skill Hub API"
API_V1_STR="/api/v1"
SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS"
ALGORITHM="HS256"
# In production, ACCESS_TOKEN_EXPIRE_MINUTES must be <= 60 minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_ENV="production"

# Database Configuration (MySQL 8 is the primary default)
# Format: mysql+pymysql://<user>:<password>@<host>:3306/<database>?charset=utf8mb4
# (SQLite fallback is permitted ONLY in development/test environments and prohibited in production)
DATABASE_URL="mysql+pymysql://skillhub_user:skillhub_secure_password@mysql:3306/skillhub_db?charset=utf8mb4"

# CORS Configuration (comma-separated origins; wildcard '*' is strictly prohibited in production)
CORS_ORIGINS="https://skillhub.corp.net,http://localhost:4300"

# Proctoring Configuration (debug overlay is disabled in production)
PROCTORING_DEBUG=false

# Phase 5: Meeting Provider & SMTP Configuration
ALLOWED_EMAIL_DOMAINS="csm.tech"
ALLOWED_MEETING_DOMAINS="teams.microsoft.com,teams.live.com,zoom.us,meet.google.com"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@csm.tech"
UPLOAD_DIR="uploads/trainings"

# Phase 6: LLM & AI Chatbot Configuration
# Provider: openai, anthropic, or mock (mock prohibited in APP_ENV=production)
LLM_PROVIDER="openai"
LLM_API_KEY=""
LLM_MODEL="gpt-4o"
LLM_BASE_URL=""
CHAT_RATE_LIMIT_PER_HOUR=20
CHAT_MAX_MESSAGE_CHARS=1000
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=30

# Phase 7: Sandboxed Code Execution Subsystem (Judge0 CE)
JUDGE0_URL="http://judge0-server:2358"
JUDGE0_CPU_TIME_LIMIT=2.0
JUDGE0_WALL_TIME_LIMIT=5.0
JUDGE0_MEMORY_LIMIT=256000
JUDGE0_MAX_PROCESSES=30
JUDGE0_MAX_OUTPUT_SIZE=100000
JUDGE0_ENABLE_NETWORK=false
CODING_RUN_RATE_LIMIT_PER_ATTEMPT=20

# Phase 13: Microsoft Integration (SSO, Teams Meetings, Attendance Import, Notification Bot)
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_REDIRECT_URI="https://skillhub.corp.net/auth/sso/callback"
AZURE_BOT_APP_ID=""
AZURE_BOT_APP_PASSWORD=""
AZURE_BOT_ENDPOINT=""
SSO_AUTO_PROVISION_ASE=false
ALLOW_LOCAL_LOGIN=true
TOKEN_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_FERNET_KEY"
TOKEN_ROTATION_KEYS=""
SSO_PROVIDER_TYPE="auto"
ATTENDANCE_PROVIDER_TYPE="auto"
TEAMS_BOT_PROVIDER_TYPE="auto"

# Final Polish: Configurable Data Retention Policies (in Days; must be confirmed by HR/Legal)
CHAT_TRANSCRIPT_RETENTION_DAYS=90
PROCTORING_SNAPSHOT_RETENTION_DAYS=30
ATTENDANCE_STAGING_RETENTION_DAYS=30
ADMIN_AUDIT_LOG_RETENTION_DAYS=365
SSO_AUDIT_LOG_RETENTION_DAYS=180
FORUM_AUDIT_LOG_RETENTION_DAYS=180
MENTOR_NOTES_RETENTION_DAYS=365

# Final Polish: Security Hardening & Lockout Policies
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=1800
BREAK_GLASS_RATE_LIMIT_PER_MINUTE=3
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

